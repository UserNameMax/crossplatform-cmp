    <!-- A2 Память по позиции -->
    <string name="a2_explanation">Одна и та же функция, одно и то же имя переменной внутри. Смотрите, сколько получилось разных чисел.</string>
    <string name="a2_branch_a">Ветка A</string>
    <string name="a2_branch_b">Ветка B</string>
    <string name="a2_hint">переключайте и следите за нижним числом</string>
